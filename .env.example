# Backend settings; Azure values are optional locally.
SQLITE_PATH=data/agentdrift.sqlite
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Production must use durable Azure Table Storage with managed identity.
AZURE_TABLE_ENDPOINT=
AZURE_CLIENT_ID=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
# Optional trusted ingestion only; never put this token in VITE variables.
INGESTION_TOKEN=
# Explicit opt-in. Leave false until model quota, pricing and resource use are approved.
LLM_ENABLED=false
LLM_REQUEST_TIMEOUT_SECONDS=15
LLM_MAX_OUTPUT_TOKENS=1500
# Hard ceiling enforced server-side; configuration may lower but cannot raise these.
LLM_MONTHLY_ATTEMPT_LIMIT=100
LLM_DAILY_ATTEMPT_LIMIT=10
LLM_SESSION_DAILY_ATTEMPT_LIMIT=2
# Optional server-side secret only; prefer resource-scoped managed identity.
AZURE_OPENAI_API_KEY=
# Separate billable integration test; never enable in ordinary CI.
RUN_AZURE_OPENAI_INTEGRATION=false
